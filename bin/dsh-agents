#!/bin/sh
root=$(cd -P "$(dirname "$0")/.." && pwd) || exit 1
if command -v bun >/dev/null 2>&1; then
  bun=$(command -v bun)
elif [ -x "${BUN_INSTALL:-$HOME/.bun}/bin/bun" ]; then
  bun="${BUN_INSTALL:-$HOME/.bun}/bin/bun"
else
  printf '%s\n' 'dsh-agents: bun not found' >&2
  exit 127
fi
exec "$bun" run "$root/src/cli.ts" "$@"
